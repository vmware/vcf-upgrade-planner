        "vcenter": {
            "name": "vCenter",
            "steps": [
                "Upgrade vCenter using VCF Operations through Fleet Management - All Guidance is provided in link (<a href='https://techdocs.broadcom.com/us/en/vmware-cis/vcf/vcf-9-0-and-later/9-1/deployment/upgrading-cloud-foundation/upgrade-the-management-domain-to-vmware-cloud-foundation-5-2/updating-vcenter-and-nsx/optimized-update-of-vcenter-and-nsx-manager.html' target='_blank'>View Documentation</a>)."
            ],
            "notices": [
                {
                    "type": "warning",
                    "title": "Integrated Windows Authentication on vCenter",
                    "bullets": [
                        "Replace Integrated Windows Authentication configured with another IDP configuration"
                    ]
                },
            {
                "type": "warning",
                "title": "If RDU Upgrade Fails - Rollback Steps",
                "bullets": [
                    "1. Shutdown target vCenter.",
                    "2. Run script to stop the RDU - All Guidance is provided in link (<a href='https://knowledge.broadcom.com/external/article/311902/' target='_blank'>View Documentation</a>).",
                    "3. Roll back the precheck change on the 8.0 vCenter for Workspace ONE broker - All Guidance is provided in link (<a href='https://knowledge.broadcom.com/external/article/443558' target='_blank'>View Documentation</a>).",
                    "4. Reboot vCenter."
                ]
            }
        ]
        },
