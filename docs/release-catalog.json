{
  "_meta": {
    "description": "Which component build ships in each VCF release (the release bill of materials). Read by every plan page and by index.html. NOT generated by refresh_compat.py - the values come from the Broadcom release notes.",
    "how_to_add_a_release": [
      "1. Add one block to 'builds' keyed by the VCF build number (the value users pick as the target version).",
      "2. In 'components' list the build that ships for each product. Products you omit are assumed to ship the same build number as the VCF build.",
      "3. Run `python3 docs/test_plan_phases.py` - it fails if a component build is not a real build in compat-data.json, or if an index target has no entry here.",
      "If you skip this, the page still works: an unlisted build inherits the nearest lower build in the same release line and logs a console warning."
    ],
    "products": [
      "vcenter",
      "esx",
      "nsx",
      "operations",
      "automation",
      "sddc_manager",
      "avi"
    ],
    "fields": {
      "components": "build of each product that ships in this VCF build (omitted product = same build number)",
      "release_notes": "component name (as shown on the page) -> release-notes URL for this build; omitted = no link",
      "main_release_notes": "single VCF release-notes URL shown for GA / roll-up builds instead of per-component links",
      "display_version": "build number shown in page text in place of '9.1' (omit to show the build itself)",
      "upgrade_text_patches": "[{old,new}] sentence replacements applied to the loaded upgrade JSON for this build",
      "patched_components": "components that ship a patch in this build; drives the 'Apply Patches' version table (effective version = newest build <= target in which the component was patched)",
      "components.avi": "Avi Load Balancer version for this VCF build (its own 32.x scheme). Unlisted builds inherit the nearest lower build, even across release lines.",
      "workload_domain_upgrade": "false = hide the Workload Domain option for this target: the build only patches management services, and a workload domain has none (nothing to upgrade). Exact build only (not inherited); omit for normal builds."
    }
  },
